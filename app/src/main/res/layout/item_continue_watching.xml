<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="?attr/colorSurface"
        android:stateListAnimator="@animator/card_state_animator">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- Thumbnail container with better aspect ratio -->
        <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="168dp">

            <!-- Episode thumbnail with rounded top corners -->
            <ImageView
                    android:id="@+id/episode_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Episode thumbnail"
                    tools:src="@tools:sample/backgrounds/scenic" />

            <!-- Dark overlay for better contrast -->
            <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/gradient_dark_overlay"
                    android:alpha="0.3" />

            <!-- Play icon overlay -->
            <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play_circle"
                    android:alpha="0.8"
                    app:tint="@android:color/white"
                    android:contentDescription="Play episode" />

            <!-- Progress indicator at bottom -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:background="@drawable/gradient_bottom_overlay"
                    android:padding="8dp">

                <!-- Time remaining indicator -->
                <TextView
                        android:id="@+id/time_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/rounded_background_dark"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:layout_marginBottom="4dp"
                        tools:text="12 min left" />

                <!-- Progress bar with better styling -->
                <ProgressBar
                        android:id="@+id/episode_progress_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:progressDrawable="@drawable/custom_seekbar_progress"
                        android:background="@drawable/progress_background"
                        tools:progress="65" />

            </LinearLayout>

        </FrameLayout>

        <!-- Content section with improved typography -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

            <!-- Anime title with better styling -->
            <TextView
                    android:id="@+id/anime_title_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:letterSpacing="0.01"
                    tools:text="Attack on Titan" />

            <!-- Episode information with better hierarchy -->
            <TextView
                    android:id="@+id/episode_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    tools:text="S4 E28: The Dawn of Humanity" />

            <!-- Additional metadata -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                <!-- Episode duration -->
                <TextView
                        android:id="@+id/episode_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:background="@drawable/rounded_background_light"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        tools:text="24 min" />

                <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                <!-- Watch date -->
                <TextView
                        android:id="@+id/watch_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="2 days ago" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Focus indicator for TV navigation -->
    <View
            android:id="@+id/focus_indicator"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/tv_focus_indicator"
            android:visibility="gone"
            android:alpha="0" />

</com.google.android.material.card.MaterialCardView>

