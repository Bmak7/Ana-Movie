<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:app="http://schemas.android.com/apk/res-auto"
             xmlns:tools="http://schemas.android.com/tools"
             android:layout_width="match_parent"
             android:layout_height="match_parent"
             android:background="@android:color/black"
             android:fitsSystemWindows="true"
             android:animateLayoutChanges="true"
             tools:context="com.faselhd.app.VideoPlayerActivity">

    <!-- ExoPlayer View -->
    <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            app:resize_mode="fill"
            app:use_controller="false"
            app:surface_type="texture_view" />

    <!-- Top Overlay with enhanced gradient -->
    <LinearLayout
            android:id="@+id/top_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/gradient_overlay_top"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="visible"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:elevation="8dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

            <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/circular_ripple_background"
                    android:contentDescription="@string/back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@android:color/white"
                    android:focusable="true"
                    android:elevation="4dp"
                    android:stateListAnimator="@animator/button_state_animator"
                    android:nextFocusDown="@id/btn_play_pause"
                    android:nextFocusRight="@id/tv_resolution"
                    android:nextFocusLeft="@id/btn_back" />

            <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

            <TextView
                    android:id="@+id/tv_resolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/enhanced_resolution_badge"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:elevation="2dp"
                    android:layout_marginEnd="4dp"
                    tools:text="1080p (Auto)" />

        </LinearLayout>

        <TextView
                android:id="@+id/tv_episode_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                tools:text="Episode Title" />

    </LinearLayout>

    <!-- Enhanced Center Controls with better spacing -->
    <LinearLayout
            android:id="@+id/center_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="visible"
            android:clipChildren="false"
            android:clipToPadding="false">

        <FrameLayout
                android:id="@+id/btn_rewind"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginEnd="48dp"
                android:background="@drawable/enhanced_control_background"
                android:clickable="true"
                android:focusable="true"
                android:elevation="6dp"
                android:stateListAnimator="@animator/control_button_animator"
                android:nextFocusRight="@id/btn_play_pause"
                android:nextFocusDown="@id/seek_bar"
                android:nextFocusUp="@id/btn_back">

            <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@drawable/replay_10_24px"
                    app:tint="@android:color/white" />
        </FrameLayout>

        <FrameLayout
                android:id="@+id/btn_play_pause"
                android:layout_width="108dp"
                android:layout_height="108dp"
                android:background="@drawable/enhanced_play_pause_background"
                android:clickable="true"
                android:focusable="true"
                android:elevation="8dp"
                android:stateListAnimator="@animator/play_button_animator"
                android:nextFocusLeft="@id/btn_rewind"
                android:nextFocusRight="@id/btn_fast_forward"
                android:nextFocusUp="@id/btn_back"
                android:nextFocusDown="@id/seek_bar">

            <ImageView
                    android:id="@+id/iv_play_pause"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play_arrow_large"
                    app:tint="@android:color/white" />
        </FrameLayout>

        <FrameLayout
                android:id="@+id/btn_fast_forward"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginStart="48dp"
                android:background="@drawable/enhanced_control_background"
                android:clickable="true"
                android:focusable="true"
                android:elevation="6dp"
                android:stateListAnimator="@animator/control_button_animator"
                android:nextFocusLeft="@id/btn_play_pause"
                android:nextFocusDown="@id/seek_bar"
                android:nextFocusUp="@id/btn_back">

            <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@drawable/forward_10_24px"
                    app:tint="@android:color/white" />
        </FrameLayout>
    </LinearLayout>

    <!-- Enhanced Seek Time Display -->
    <TextView
            android:id="@+id/tv_seek_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="-120dp"
            android:background="@drawable/enhanced_seek_time_background"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:elevation="10dp"
            android:visibility="gone"
            tools:text="+01:22 [34:55]" />

    <!-- Enhanced Bottom Controls -->
    <LinearLayout
            android:id="@+id/bottom_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/gradient_overlay_bottom"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="visible"
            android:elevation="8dp"
            android:clipChildren="false"
            android:clipToPadding="false">

        <!-- Enhanced Progress Section -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <TextView
                    android:id="@+id/tv_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="52dp"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:shadowColor="#80000000"
                    android:shadowRadius="1"
                    tools:text="00:00" />

            <SeekBar
                    android:id="@+id/seek_bar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:max="100"
                    android:progressDrawable="@drawable/enhanced_seekbar_progress"
                    android:thumb="@drawable/enhanced_seekbar_thumb"
                    android:splitTrack="false"
                    android:nextFocusUp="@id/btn_play_pause"
                    android:nextFocusDown="@id/btn_quality"/>

            <TextView
                    android:id="@+id/tv_total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:minWidth="52dp"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:shadowColor="#80000000"
                    android:shadowRadius="1"
                    tools:text="55:42" />
        </LinearLayout>

        <!-- Enhanced Control Buttons Row -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <ImageButton
                    android:id="@+id/btn_lock"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/enhanced_control_button_background"
                    android:contentDescription="@string/lock_controls"
                    android:src="@drawable/ic_lock_open"
                    app:tint="@android:color/white"
                    android:focusable="true"
                    android:elevation="4dp"
                    android:stateListAnimator="@animator/button_state_animator"
                    android:nextFocusUp="@id/seek_bar"
                    android:nextFocusRight="@id/btn_quality"/>

            <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

            <ImageButton
                    android:id="@+id/btn_quality"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/enhanced_control_button_background"
                    android:contentDescription="@string/quality"
                    android:src="@drawable/settings_24px"
                    app:tint="@android:color/white"
                    android:focusable="true"
                    android:elevation="4dp"
                    android:stateListAnimator="@animator/button_state_animator"
                    android:nextFocusUp="@id/seek_bar"
                    android:nextFocusLeft="@id/btn_lock"
                    android:nextFocusRight="@id/btn_resize"/>

            <ImageButton
                    android:id="@+id/btn_resize"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/enhanced_control_button_background"
                    android:contentDescription="@string/resize_mode"
                    android:src="@drawable/ic_resize"
                    app:tint="@android:color/white"
                    android:focusable="true"
                    android:elevation="4dp"
                    android:stateListAnimator="@animator/button_state_animator"
                    android:nextFocusUp="@id/seek_bar"
                    android:nextFocusLeft="@id/btn_quality"
                    android:nextFocusRight="@id/btn_fullscreen"/>

            <ImageButton
                    android:id="@+id/btn_fullscreen"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/enhanced_control_button_background"
                    android:contentDescription="@string/fullscreen"
                    android:src="@drawable/mobile_rotate_24px"
                    app:tint="@android:color/white"
                    android:focusable="true"
                    android:elevation="4dp"
                    android:stateListAnimator="@animator/button_state_animator"
                    android:nextFocusUp="@id/seek_bar"
                    android:nextFocusLeft="@id/btn_resize"
                    android:nextFocusRight="@id/btn_subtitle"/>

            <ImageButton
                    android:id="@+id/btn_subtitle"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/enhanced_control_button_background"
                    android:contentDescription="@string/subtitles"
                    android:src="@drawable/ic_subtitles"
                    app:tint="@android:color/white"
                    android:focusable="true"
                    android:elevation="4dp"
                    android:stateListAnimator="@animator/button_state_animator"
                    android:nextFocusUp="@id/seek_bar"
                    android:nextFocusLeft="@id/btn_fullscreen"
                    android:nextFocusRight="@id/btn_next_episode"/>

            <ImageButton
                    android:id="@+id/btn_next_episode"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/enhanced_control_button_background"
                    android:contentDescription="@string/next_episode"
                    android:src="@drawable/ic_skip_next"
                    app:tint="@android:color/white"
                    android:focusable="true"
                    android:elevation="4dp"
                    android:stateListAnimator="@animator/button_state_animator"
                    android:nextFocusUp="@id/seek_bar"
                    android:nextFocusLeft="@id/btn_subtitle"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Enhanced Lock Overlay -->
    <FrameLayout
            android:id="@+id/lock_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            tools:visibility="gone">

        <ImageButton
                android:id="@+id/btn_unlock"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/enhanced_unlock_button_background"
                android:src="@drawable/ic_lock"
                app:tint="@android:color/white"
                android:elevation="12dp"
                android:stateListAnimator="@animator/unlock_button_animator"
                android:focusable="true"/>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="120dp"
                android:text="Screen is locked"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:alpha="0.8"
                android:shadowColor="#80000000"
                android:shadowRadius="2" />
    </FrameLayout>

    <!-- Enhanced Loading Indicator -->
    <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

        <ProgressBar
                android:id="@+id/loading_indicator"
                style="@android:style/Widget.Material.ProgressBar.Large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@android:color/white"
                android:elevation="10dp"
                android:visibility="gone" />
    </FrameLayout>

    <!-- Enhanced Skip Intro Button -->
    <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_skip_intro"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="140dp"
            android:focusable="true"
            android:text="Skip Intro"
            android:textSize="14sp"
            android:textStyle="bold"
            android:elevation="8dp"
            android:stateListAnimator="@animator/skip_button_animator"
            android:backgroundTint="#E91E63"
            android:nextFocusUp="@id/btn_fast_forward"
            android:nextFocusLeft="@id/btn_next_episode"
            app:icon="@drawable/ic_skip_next"
            app:iconSize="20dp"
            app:cornerRadius="24dp"
            android:visibility="gone"
            tools:visibility="gone" />

    <!-- Enhanced Volume Overlay -->
    <LinearLayout
            android:id="@+id/volume_overlay"
            android:layout_width="140dp"
            android:layout_height="220dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="24dp"
            android:background="@drawable/enhanced_overlay_background"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:elevation="10dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            tools:visibility="gone">

        <ImageView
                android:id="@+id/iv_volume_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginBottom="20dp"
                android:src="@drawable/ic_volume_up"
                app:tint="@android:color/white"/>

        <ProgressBar
                android:id="@+id/volume_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="140dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:max="100"
                android:progress="75"
                android:progressDrawable="@drawable/enhanced_vertical_progress"
                android:rotation="270" />

        <TextView
                android:id="@+id/tv_volume_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="75%"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

    </LinearLayout>

    <!-- Enhanced Brightness Overlay -->
    <LinearLayout
            android:id="@+id/brightness_overlay"
            android:layout_width="140dp"
            android:layout_height="220dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="24dp"
            android:background="@drawable/enhanced_overlay_background"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:elevation="10dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            tools:visibility="gone">

        <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginBottom="20dp"
                android:src="@drawable/ic_brightness"
                app:tint="@android:color/white"/>

        <ProgressBar
                android:id="@+id/brightness_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="140dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:max="100"
                android:progress="50"
                android:progressDrawable="@drawable/enhanced_vertical_progress"
                android:rotation="270" />

        <TextView
                android:id="@+id/tv_brightness_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="50%"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

    </LinearLayout>

    <!-- Enhanced Rewind Indicator -->
    <LinearLayout
            android:id="@+id/rewind_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="80dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:elevation="8dp"
            android:background="@drawable/enhanced_indicator_background"
            android:padding="16dp"
            tools:visibility="gone">

        <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/replay_10_24px"
                app:tint="@android:color/white" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="-10 seconds"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
    </LinearLayout>

    <!-- Enhanced Forward Indicator -->
    <LinearLayout
            android:id="@+id/forward_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="80dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:elevation="8dp"
            android:background="@drawable/enhanced_indicator_background"
            android:padding="16dp"
            tools:visibility="gone">

        <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/forward_10_24px"
                app:tint="@android:color/white" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="+10 seconds"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
    </LinearLayout>

    <!-- Enhanced Speed Indicator -->
    <TextView
            android:id="@+id/speed_indicator_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="40dp"
            android:background="@drawable/enhanced_speed_indicator_background"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:text="Speed: 2.0x"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:elevation="10dp"
            android:visibility="gone"
            tools:visibility="gone" />

</FrameLayout>