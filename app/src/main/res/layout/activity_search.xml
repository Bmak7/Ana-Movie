<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        tools:context="com.faselhd.app.SearchActivity">

    <!-- Top Search Bar and Filter Button -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="28dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant">

            <androidx.appcompat.widget.SearchView
                    android:id="@+id/search_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:queryHint="Search anime..."
                    app:iconifiedByDefault="false"
                    app:searchIcon="@drawable/ic_search"
                    app:queryBackground="@android:color/transparent" />

        </com.google.android.material.card.MaterialCardView>

        <ImageButton
                android:id="@+id/filter_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/filter_list_24px"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginStart="8dp"
                android:contentDescription="Filter search options"/>

    </LinearLayout>

    <!-- Content Area: This FrameLayout will show one of its children at a time -->
    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <!-- 1. Initial State: Top Searches -->
        <LinearLayout
                android:id="@+id/top_searches_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Top Searches"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textStyle="bold"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/top_searches_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    tools:listitem="@layout/item_top_search"/>
        </LinearLayout>


        <!-- 2. Search Results State -->
        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/search_results_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:clipToPadding="false"
                app:spanCount="3"
                tools:listitem="@layout/item_anime_grid"
                tools:visibility="visible"/>

        <!-- 3. Not Found State -->
        <LinearLayout
                android:id="@+id/not_found_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                tools:visibility="visible">

            <ImageView
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:src="@drawable/ic_not_found_illustration"
                    android:contentDescription=""/>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not Found"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textColor="@color/green_see_all"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"/>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sorry, the keyword you entered could not be found. Try to check again or search with other keywords."
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:gravity="center"
                    android:layout_marginHorizontal="32dp"
                    android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- Loading Indicator -->
        <androidx.compose.ui.platform.ComposeView
                android:id="@+id/compose_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"/>

    </FrameLayout>

</LinearLayout>