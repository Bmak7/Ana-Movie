<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto"
                                                   xmlns:tools="http://schemas.android.com/tools"
                                                   android:id="@+id/mini_player_container"
                                                   android:layout_width="match_parent"
                                                   android:layout_height="wrap_content"
                                                   android:layout_marginHorizontal="8dp"
                                                   android:layout_marginBottom="8dp"
                                                   android:clickable="true"
                                                   android:focusable="true"
                                                   android:foreground="?attr/selectableItemBackground"
                                                   android:visibility="gone"
                                                   app:cardCornerRadius="16dp"
                                                   app:cardElevation="8dp"
                                                   app:cardBackgroundColor="@color/mini_player_background"
                                                   tools:visibility="visible">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

        <!-- Song Artwork -->
        <com.google.android.material.card.MaterialCardView
                android:id="@+id/mini_artwork_card"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <ImageView
                    android:id="@+id/mini_song_artwork"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/placeholder_anime"
                    tools:src="@tools:sample/avatars" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Song Info Container -->
        <LinearLayout
                android:id="@+id/song_info_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@+id/mini_artwork_card"
                app:layout_constraintEnd_toStartOf="@+id/controls_container"
                app:layout_constraintStart_toEndOf="@+id/mini_artwork_card"
                app:layout_constraintTop_toTopOf="@+id/mini_artwork_card">

            <!-- Song Title -->
            <TextView
                    android:id="@+id/mini_song_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Current Song Playing" />

            <!-- Artist Name -->
            <TextView
                    android:id="@+id/mini_song_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Artist Name" />

        </LinearLayout>

        <!-- Controls Container -->
        <LinearLayout
                android:id="@+id/controls_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="@+id/mini_artwork_card"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/mini_artwork_card">

            <!-- Previous Button -->
            <ImageButton
                    android:id="@+id/mini_btn_previous"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Previous song"
                    android:padding="8dp"
                    android:src="@drawable/ic_skip_previous"
                    app:tint="@color/text_primary" />

            <!-- Play/Pause Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/mini_btn_play_pause"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="4dp"
                    android:contentDescription="Play/Pause"
                    app:backgroundTint="@color/colorPrimary"
                    app:fabCustomSize="44dp"
                    app:maxImageSize="24dp"
                    app:srcCompat="@drawable/ic_play_arrow"
                    app:tint="@color/white" />

            <!-- Next Button -->
            <ImageButton
                    android:id="@+id/mini_btn_next"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Next song"
                    android:padding="8dp"
                    android:src="@drawable/ic_skip_next"
                    app:tint="@color/text_primary" />

        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
                android:id="@+id/mini_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="45"
                android:progressTint="@color/colorPrimary"
                android:progressBackgroundTint="@color/progress_background"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mini_artwork_card" />

        <!-- Close/Dismiss Button -->
        <ImageButton
                android:id="@+id/mini_btn_close"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_margin="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close mini player"
                android:padding="2dp"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/text_tertiary"
                tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>