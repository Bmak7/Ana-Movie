            android:layout_width="match_parent"
            android:layout_height="240dp"/>

    <View
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="8dp"/>

    <View
            android:layout_width="120dp"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"/>
</LinearLayout>